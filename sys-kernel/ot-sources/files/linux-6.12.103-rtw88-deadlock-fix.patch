+void rtw_fw_recovery(struct rtw_dev *rtwdev)
+{
+	if (!test_bit(RTW_FLAG_RESTARTING, rtwdev->flags))
+		ieee80211_queue_work(rtwdev->hw, &rtwdev->fw_recovery_work);
+}
+
+static void __fw_recovery_work(struct rtw_dev *rtwdev)
+{
+	int ret = 0;
+	bool was_fail = rtwdev->fail;
+
+	set_bit(RTW_FLAG_RESTARTING, rtwdev->flags);
+	clear_bit(RTW_FLAG_RESTART_TRIGGERING, rtwdev->flags);
+
+	/* If recovery was triggered by USB -110 storm (0xaa / 0x4e0),
+	 * rtwdev->fail is true. Don't do fwcd dump which does more
+	 * register IO that will also fail with -110. Skip to reset.
+	 */
+	if (was_fail) {
+		rtw_warn(rtwdev, "rtw88: bypass fw crash dump, USB failed, going to reset\n");
+		goto reset;
+	}
+
+	ret = rtw_fwcd_prep(rtwdev);
+	if (ret)
+		goto free;
+	ret = rtw_fw_dump_crash_log(rtwdev);
+	if (ret)
+		goto free;
+	ret = rtw_chip_dump_fw_crash(rtwdev);
+	if (ret)
+		goto free;
+
+	rtw_fwcd_dump(rtwdev);
+free:
+	rtw_fwcd_free(rtwdev, !!ret);
+	rtw_write8(rtwdev, REG_MCU_TST_CFG, 0);
+
+	WARN(1, "firmware crash, start reset and recover\n");
+
+reset:
+	rcu_read_lock();
+	rtw_iterate_keys_rcu(rtwdev, NULL, rtw_reset_key_iter, rtwdev);
+	rcu_read_unlock();
+	rtw_iterate_stas_atomic(rtwdev, rtw_reset_sta_iter, rtwdev);
+	rtw_iterate_vifs_atomic(rtwdev, rtw_reset_vif_iter, rtwdev);
+	bitmap_zero(rtwdev->hw_port, RTW_PORT_NUM);
+	rtw_enter_ips(rtwdev);
+
+	/* Clear USB fail state after reset path prepared.
+	 * This is called with rtwdev->mutex held by caller
+	 * rtw_fw_recovery_work(), so safe to clear here.
+	 * Also clear fail_count so next -110 storm is detected anew.
+	 */
+	rtwdev->fail = false;
+	atomic_set(&rtwdev->fail_count, 0);
+}
+
+static void rtw_fw_recovery_work(struct work_struct *work)
+{
+	struct rtw_dev *rtwdev = container_of(work, struct rtw_dev,
+					      fw_recovery_work);
+	struct rtw_usb *rtwusb;
+	bool was_fail;
+
+	was_fail = rtwdev->fail;
+	if (was_fail) {
+		rtwusb = rtw_get_usb_priv(rtwdev);
+		/* usb_reset_device sleeps, must be outside mutex */
+		usb_reset_device(rtwusb->udev);
+	}
+
+	mutex_lock(&rtwdev->mutex);
+	__fw_recovery_work(rtwdev);
+	mutex_unlock(&rtwdev->mutex);
+
+	/* Final clear after restart_hw - ensures TX path in
+	 * rtw_usb_write_data can proceed. Free after unlock order.
+	 */
+	rtwdev->fail = false;
+	atomic_set(&rtwdev->fail_count, 0);
+
+	ieee80211_restart_hw(rtwdev->hw);
+}
