# @ECLASS: secure-versions-rust.eclass
# @MAINTAINER: Orson Teodoro <orsonteodoro@hotmail.com>
# @SUPPORTED_EAPIS: 7 8 9
# @BLURB: secure versions for Rust
# @DESCRIPTION:
# Install *only* secure versions for Rust.

case ${EAPI:-0} in
	[789]) ;;
	*) die "${ECLASS}: EAPI ${EAPI:-0} not supported" ;;
esac

if [[ -z "${_SECURE_VERSION_RUST_ECLASS}" ]] ; then
_SECURE_VERSION_RUST_ECLASS=1

# You must prefix your entry with RUST_

RUST_AWS_CONFIG_PV=${RUST_AWS_CONFIG_PV:-"1.13.0"}
RUST_AWS_CREDENTIAL_TYPES_PV=${RUST_AWS_CREDENTIAL_TYPES_PV:-"1.3.1"}
RUST_AWS_LC_RS_PV=${RUST_AWS_LC_RS_PV:-"1.71.0"}
RUST_AWS_LC_SYS_PV=${RUST_AWS_LC_SYS_PV:-"0.47.0"}
RUST_AWS_SDK_KINESISVIDEO_PV=${RUST_AWS_SDK_KINESISVIDEO_PV:-"1.122.0"}
RUST_AWS_SDK_KINESISVIDEOSIGNALING_PV=${RUST_AWS_SDK_KINESISVIDEOSIGNALING_PV:-"1.119.0"}
RUST_AWS_SDK_POLLY=${RUST_AWS_SDK_POLLY:-"1.127.0"}
RUST_AWS_SDK_S3_PV=${RUST_AWS_SDK_S3_PV:-"1.157.0"}
RUST_AWS_SDK_SSO_PV=${RUST_AWS_SDK_SSO_PV:-"1.119.0"}
RUST_AWS_SDK_STS_PV=${RUST_AWS_SDK_STS_PV:-"1.124.0"}
RUST_AWS_SDK_TRANSCRIBESTREAMING_PV=${RUST_AWS_SDK_TRANSCRIBESTREAMING_PV:-"1.126.0"}
RUST_AWS_SDK_TRANSLATE_PV=${RUST_AWS_SDK_TRANSLATE_PV:-"1.120.0"}
RUST_AWS_SIGV4_PV=${RUST_AWS_SIGV4_PV:-"1.6.4"}
RUST_AWS_SMITHY_HTTP_CLIENT_PV=${RUST_AWS_SMITHY_HTTP_CLIENT_PV:-"1.5.2"}
RUST_AWS_SMITHY_HTTP_PV=${RUST_AWS_SMITHY_HTTP_PV:-"0.64.3"}
RUST_AWS_SMITHY_RUNTIME_PV=${RUST_AWS_SMITHY_RUNTIME_PV:-"1.16.2"}
RUST_AWS_SMITHY_TYPES_PV=${RUST_AWS_SMITHY_TYPES_PV:-"1.9.1"}
RUST_AWS_TYPES_PV=${RUST_AWS_TYPES_PV:-"1.7.0"}
RUST_CLAP_PV=${RUST_CLAP_PV:-"4.6.7"}
RUST_CMOV_PV=${RUST_CMOV_PV:-"0.5.4"}
RUST_GLIB_3_PV=${RUST_GLIB_3_PV:-"0.22.8"} # GTK3
RUST_GLIB_4_PV=${RUST_GLIB_4_PV:-"0.22.10"} # GTK4
RUST_GTK_PV=${RUST_GTK_PV:-"0.19.0"} # GTK3
RUST_GTK4_PV=${RUST_GTK4_PV:-"0.11.5"}
RUST_EVENTSOURCE_CLIENT_PV=${RUST_EVENTSOURCE_CLIENT_PV:-"0.18.1"}
RUST_HYPER_TLS_PV=${RUST_HYPER_TLS_PV:-"0.6.0"}
RUST_LRU_PV=${RUST_LRU_PV:-"0.19.0"}
RUST_OPENTELEMETRY_SDK_PV=${RUST_OPENTELEMETRY_SDK_PV:-"0.33.1"}
RUST_PYO3_PV=${RUST_PYO3_PV:-"0.30.1"} # Version sensitive
RUST_QUINN_PROTO_PV=${RUST_QUINN_PROTO_PV:-"0.11.19"}
RUST_RAND_PV=${RUST_RAND_PV:-"0.10.3"} # Version sensitive
RUST_REQWEST_PV=${RUST_REQWEST_PV:-"0.13.5"}
RUST_RUSTLS_AWS_LC_RS_PV=${RUST_RUSTLS_AWS_LC_RS_PV:-"0.0.1"}
RUST_RUSTLS_PV=${RUST_RUSTLS_PV:-"0.23.46"} # Do not use directly.  For info only.  Update the problematic dependent (depender) first.
RUST_THRIFT_PV=${RUST_THRIFT_PV:-"0.25.0"}
RUST_XXHASH_RUST_PV=${RUST_XXHASH_RUST_PV:-"0.8.19"}
RUST_ZIP_PV=${RUST_ZIP_PV:-"9.0.5"}

fi
