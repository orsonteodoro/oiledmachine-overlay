# @ECLASS: secure-versions-rust.eclass
# @MAINTAINER: Orson Teodoro <orsonteodoro@hotmail.com>
# @SUPPORTED_EAPIS: 7 8 9
# @BLURB: secure versions for Rust
# @DESCRIPTION:
# Install *only* secure versions for Rust.

case ${EAPI:-0} in
	[789]) ;;
	*) die "${ECLASS}: EAPI ${EAPI:-0} not supported" ;;
esac

if [[ -z "${_SECURE_VERSION_RUST_ECLASS}" ]] ; then
_SECURE_VERSION_RUST_ECLASS=1

# This timestamp was generated from `date +%s`.
# This is a quick and simplified check to see if the secure lockfile versions are up to date in O(1) time.
SECURE_VERSION_RUST_ECLASS_UPDATE=1793849048

# You must prefix your entry with RUST_

# Packages should be added to this eclass if one of the following is true:
# Packages that have vulnerabilities fixes should be listed as latest version.
# Packages that impede remediation should be listed as latest version.
# Packages that use unsafe and have reported/unreported vulnerabilities (double-free, UAF, etc) should be listed.

# GTK 3
RUST_CAIRO_RS_3_PV=${RUST_CAIRO_RS_3_PV:-"0.22.8"}
