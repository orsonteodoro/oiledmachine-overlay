#!/usr/bin/env bash
set -euo pipefail

# This file is mostly AI generated.

# It is assumed that the system is booted with either Gentoo LiveUSB,
# SystemRescue, or a rescue partition with unpacked Gentoo state3 tarball or
# SystemRescue.  This script runs in that context not on the live production
# system.

echo "WARNING:  DRAFT.  This script is not tested yet."

# Explicitly use host tools (critical when running from SystemRescueCD)
LN_BIN="/bin/ln"
RM_BIN="/bin/rm"
MKDIR_BIN="/bin/mkdir"

TARGET_ROOT="/"
PROVIDER=""

usage() {
    echo "Usage: $0 [--root /mnt/gentoo] <gnu|uutils|uutils-bin>"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --root)
            TARGET_ROOT="${2%/}"
            [[ -z "$TARGET_ROOT" ]] && TARGET_ROOT="/"
            shift 2
            ;;
        gnu|uutils|uutils-bin)
            PROVIDER="$1"
            shift
            ;;
        *)
            usage
            ;;
    esac
done

[[ -z "$PROVIDER" ]] && usage

case "$PROVIDER" in
    gnu)        SRC_SUBDIR="usr/lib/gnu-coreutils" ;;
    uutils)     SRC_SUBDIR="usr/lib/uucore-utils" ;;
    uutils-bin) SRC_SUBDIR="usr/lib/uutils-coreutils-bin" ;;
esac

FULL_SRC="${TARGET_ROOT}/${SRC_SUBDIR}"
[[ "$TARGET_ROOT" == "/" ]] && FULL_SRC="/${SRC_SUBDIR}"

if [[ ! -d "$FULL_SRC" ]]; then
    echo "Error: Provider directory $FULL_SRC does not exist." >&2
    exit 1
fi

# Detect merged-usr vs split-usr in the target root
IS_MERGED_USR=0
if [[ -L "${TARGET_ROOT}/bin" ]]; then
    IS_MERGED_USR=1
    echo "Detected merged-usr layout in ${TARGET_ROOT}"
else
    echo "Detected split-usr layout in ${TARGET_ROOT}"
fi

link_tree() {
    local sub="$1"          # e.g., "bin", "usr/bin", "usr/share"
    local target_dir="$2"   # Destination relative to TARGET_ROOT, e.g., "usr/bin"
    local rel_prefix="$3"   # Relative path back to root from target_dir, e.g., ".." or "../.."

    local src_path="${FULL_SRC}/${sub}"
    local dst_path="${TARGET_ROOT}/${target_dir}"
    [[ "$TARGET_ROOT" == "/" ]] && dst_path="/${target_dir}"

    [[ ! -d "$src_path" ]] && return 0

    "$MKDIR_BIN" -p "$dst_path"

    # Iterate through files/symlinks in the provider's directory
    local item base
    for item in "$src_path"/*; do
        [[ -e "$item" || -L "$item" ]] || continue
        base="${item##*/}"
        
        # Create relative symlink so it works both in /mnt/gentoo and after reboot
        # e.g., /usr/bin/ls -> ../../usr/lib/uucore-utils/usr/bin/ls
        "$LN_BIN" -sfn "${rel_prefix}/${SRC_SUBDIR}/${sub}/${base}" "${dst_path}/${base}"
    done
}

# 1. Handle /bin and /usr/bin based on split-usr vs merged-usr
if [[ "$IS_MERGED_USR" -eq 1 ]]; then
    # In merged-usr, everything goes into /usr/bin (which /bin points to)
    link_tree "bin" "usr/bin" "../.."
    link_tree "usr/bin" "usr/bin" "../.."
else
    # In split-usr, keep /bin and /usr/bin distinct
    link_tree "bin" "bin" ".."
    link_tree "usr/bin" "usr/bin" "../.."
fi

# 2. Handle libexec, share (manpages/locales), and etc
link_tree "usr/libexec" "usr/libexec" "../.."
link_tree "etc" "etc" ".."

# For /usr/share, link subdirectories/files carefully (e.g., man/man1, locale)
if [[ -d "${FULL_SRC}/usr/share/man/man1" ]]; then
    link_tree "usr/share/man/man1" "usr/share/man/man1" "../../../.."
fi

echo "Successfully switched coreutils in '${TARGET_ROOT}' to '${PROVIDER}'."
