#!/bin/sh
# /switch-coreutils - Offline/Online Coreutils Multiplexer for Gentoo
# Designed to run from SystemRescueCD against /mnt/gentoo (or custom root)

# This file is mostly AI generated.

# It is assumed that the system is booted with either Gentoo LiveUSB,
# SystemRescue, or a rescue partition with unpacked Gentoo state3 tarball or
# SystemRescue.  This script runs in that context not on the live production
# system.

set -eu

echo "WARNING:  DRAFT.  This script is not tested yet."

PROVIDERS="gnu-coreutils uutils-coreutils uutils-coreutils-bin"
TARGET_ROOT="/mnt/gentoo"
PROVIDER=""

usage() {
    cat <<EOF
Usage: $0 <provider> [target_root]

Providers:
  gnu-coreutils         Switch to source-built GNU coreutils
  uutils-coreutils      Switch to source-built uutils-coreutils
  uutils-coreutils-bin  Switch to prebuilt uutils-coreutils-bin

Arguments:
  target_root           Path to mounted Gentoo root (default: /mnt/gentoo)

Example (from SystemRescueCD):
  /mnt/gentoo/switch-coreutils uutils-coreutils /mnt/gentoo
EOF
    exit 1
}

[ $# -lt 1 ] && usage
PROVIDER="$1"
[ $# -ge 2 ] && TARGET_ROOT="${2%/}"

# Validate provider
VALID=0
for p in $PROVIDERS; do
    [ "$PROVIDER" = "$p" ] && VALID=1
done
if [ "$VALID" -ne 1 ]; then
    echo "Error: Unknown provider '$PROVIDER'." >&2
    usage
fi

# Handle root='/' cleanly
[ "$TARGET_ROOT" = "/" ] && TARGET_ROOT=""

PROVIDER_DIR="${TARGET_ROOT}/lib/${PROVIDER}"
if [ ! -d "$PROVIDER_DIR" ]; then
    echo "Error: Provider directory '$PROVIDER_DIR' does not exist." >&2
    exit 1
fi

# Detect merged-usr vs split-usr
IS_MERGED_USR=0
if [ -L "${TARGET_ROOT}/bin" ]; then
    IS_MERGED_USR=1
    echo "Detected merged-usr layout at ${TARGET_ROOT:-/}"
else
    echo "Detected split-usr layout at ${TARGET_ROOT:-/}"
fi

# Helper: Remove old symlinks pointing to ANY managed coreutils provider
clean_stale_links() {
    dir="$1"
    [ ! -d "$dir" ] && return 0

    for item in "$dir"/*; do
        [ -L "$item" ] || continue
        target=$(readlink "$item" || true)
        for p in $PROVIDERS; do
            case "$target" in
                *"/lib/${p}/"*)
                    rm -f "$item"
                    break
                    ;;
            esac
        done
    done
}

# Helper: Link all files from a provider subdir into the system subdir
link_tree() {
    rel_sub="$1"
    src_dir="${PROVIDER_DIR}/${rel_sub}"
    dst_dir="${TARGET_ROOT}/${rel_sub}"

    # Skip /bin and /sbin on merged-usr systems
    if [ "$IS_MERGED_USR" -eq 1 ]; then
        case "$rel_sub" in
            bin|sbin) return 0 ;;
        esac
    fi

    [ -d "$dst_dir" ] || mkdir -p "$dst_dir"

    # 1. Clean up existing muxed symlinks in destination
    clean_stale_links "$dst_dir"

    # 2. Create relative symlinks (-r) for every binary/file in provider
    [ ! -d "$src_dir" ] && return 0
    for bin_path in "$src_dir"/*; do
        [ -e "$bin_path" ] || continue
        bin_name=$(basename "$bin_path")
        dst_link="${dst_dir}/${bin_name}"

        # Safety check: do not clobber real files owned by other packages (e.g., util-linux)
        if [ -e "$dst_link" ] && [ ! -L "$dst_link" ]; then
            echo "Warning: Skipping '${dst_link}' (real file exists, not a symlink)" >&2
            continue
        fi

        # Use GNU ln -sfnr to generate portable relative symlinks
        ln -sfnr "$bin_path" "$dst_link"
    done
}

echo "Switching coreutils provider in '${TARGET_ROOT:-/}' to '${PROVIDER}'..."

# Link executable directories
link_tree "bin"
#link_tree "sbin"
link_tree "usr/bin"
#link_tree "usr/sbin"
link_tree "usr/libexec/coreutils"

# Record active state
echo "$PROVIDER" > "${TARGET_ROOT}/etc/coreutils-provider"
echo "Done. Active provider is now: $PROVIDER"

