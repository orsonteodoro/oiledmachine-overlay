#!/bin/bash
# /switch-coreutils - Offline-safe coreutils symlink muxer
# Usage: /mnt/gentoo/switch-coreutils <gnu|uutils|uutils-bin> [target_root]

# This file is mostly AI generated.

# It is assumed that the system is booted with either Gentoo LiveUSB,
# SystemRescue, or a rescue partition with unpacked Gentoo state3 tarball or
# SystemRescue.  This script runs in that context not on the live production
# system.

set -euo pipefail

echo "WARNING:  DRAFT.  This script is not tested yet."


# Usage: /mnt/gentoo/switch-coreutils <gnu|uutils|uutils-bin> [target_root]
PROVIDER="${1:-}"
ROOT_DIR="${2:-/mnt/gentoo}"

# Normalize ROOT_DIR (strip trailing slash, handle '/' cleanly)
ROOT_DIR="${ROOT_DIR%/}"

case "$PROVIDER" in
    gnu)        SRC_BASE="/lib/gnu-coreutils" ;;
    uutils)     SRC_BASE="/lib/uutils-coreutils" ;;
    uutils-bin) SRC_BASE="/lib/uutils-coreutils-bin" ;;
    *)
        echo "Usage: $0 <gnu|uutils|uutils-bin> [target_root]"
        exit 1
        ;;
esac

if [[ ! -d "${ROOT_DIR}${SRC_BASE}" ]]; then
    echo "Error: Staging directory ${ROOT_DIR}${SRC_BASE} does not exist."
    exit 1
fi

# Detect if target root uses merged-usr (/bin is a symlink)
IS_MERGED_USR=0
if [[ -L "${ROOT_DIR}/bin" ]]; then
    IS_MERGED_USR=1
fi

# Backup original coreutils if not already backed up
BACKUP_DIR="${ROOT_DIR}/lib/coreutils-backup"
if [[ ! -d "$BACKUP_DIR" ]]; then
    echo "Creating initial backup at ${BACKUP_DIR}..."
    mkdir -p "${BACKUP_DIR}/bin" "${BACKUP_DIR}/usr/bin"
    for dir in bin usr/bin; do
        for item in "${ROOT_DIR}${SRC_BASE}/${dir}"/*; do
            [[ -e "$item" ]] || continue
            base="$(basename "$item")"
            target="${ROOT_DIR}/${dir}/${base}"
            if [[ -f "$target" && ! -L "$target" ]]; then
                cp -a "$target" "${BACKUP_DIR}/${dir}/"
            fi
        done
    done
fi

echo "Switching coreutils to '${PROVIDER}' on '${ROOT_DIR:-/}' (merged-usr=${IS_MERGED_USR})..."

link_binaries() {
    local src_subdir="$1"   # e.g., bin or usr/bin
    local dest_subdir="$2"  # e.g., bin or usr/bin
    local rel_prefix="$3"   # e.g., .. or ../..

    mkdir -p "${ROOT_DIR}/${dest_subdir}"

    for item in "${ROOT_DIR}${SRC_BASE}/${src_subdir}"/*; do
        [[ -e "$item" ]] || continue
        local name
        name="$(basename "$item")"
        local dest="${ROOT_DIR}/${dest_subdir}/${name}"

        # Remove existing binary or symlink safely
        rm -f "$dest"
        # Use host's ln with relative target path
        /bin/ln -s "${rel_prefix}${SRC_BASE}/${src_subdir}/${name}" "$dest"
    done
}

if [[ "$IS_MERGED_USR" -eq 1 ]]; then
    # Target is merged-usr: map both staging /bin and /usr/bin into target /usr/bin
    link_binaries "bin" "usr/bin" "../.."
    link_binaries "usr/bin" "usr/bin" "../.."
else
    # Target is split-usr: preserve exact /bin and /usr/bin separation
    link_binaries "bin" "bin" ".."
    link_binaries "usr/bin" "usr/bin" "../.."
fi

# Link /usr/libexec and /usr/share if present in the provider
for extra in usr/libexec usr/share; do
    if [[ -d "${ROOT_DIR}${SRC_BASE}/${extra}" ]]; then
        mkdir -p "${ROOT_DIR}/${extra}"
        cp -rsf "${ROOT_DIR}${SRC_BASE}/${extra}"/* "${ROOT_DIR}/${extra}/" 2>/dev/null || true
    fi
done

echo "Done. Active coreutils set to ${PROVIDER}."
