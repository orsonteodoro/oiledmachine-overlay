+int get_dynamic_width(void)
+{
+    struct winsize ws;
+    int cols = 80, rows = 24;
+
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0)
+        cols = ws.ws_col;
+    else
+        newtGetScreenSize(&cols, &rows);
+
+    // tty/x11/kms: 232, vga: 80 - both work
+    // leave 2 char border + 2 char margin
+    int w = cols - 4;
+
+    const char *term = g_getenv("TERM");
+    gboolean is_x11 = term && (strstr(term, "xterm") || strstr(term, "vte"));
+
+    // don't let it get tiny in 80-col, don't overflow in 232-col
+    if (w < 40) w = 40;
+    if (w > 232 && is_x11) w = 232; // 232 - 4
+    if (w > 235 && !is_x11) w = 235; // 235 - 4
+
+    return w;
+}
+
