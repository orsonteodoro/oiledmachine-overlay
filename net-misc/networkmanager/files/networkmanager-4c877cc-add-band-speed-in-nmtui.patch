 }
 
+const char *
+nmc_wifi_speed_emoji(guint32 freq)
+{
+    if (freq == 0)
+        return ""; // not NULL - prevents (null)
+
+    if (freq >= 5945)
+        return "6G";
+    if (freq >= 5000)
+        return "5G";
+    if (freq > 0)
+        return "2.4G";
+    return "";
+}
