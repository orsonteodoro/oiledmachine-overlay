+static int
+get_max_name_disp(void)
+{
+    struct winsize ws;
+    int cols = 80;
+    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0)
+        cols = ws.ws_col;
+
+    // overhead: " * " + " [WPA2 5G] " ~ 20 chars
+    // 80 col vga -> 80-8-20=52
+    // 236 col kms -> 236-8-20=208
+    int max = cols - 28;
+    if (max < 18) max = 18;
+    if (max > 192) max = 192;
+    return max;
+}
