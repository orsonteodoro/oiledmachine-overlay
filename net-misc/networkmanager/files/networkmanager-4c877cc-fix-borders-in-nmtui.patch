diff '--color=auto' -urp networkmanager-9999.orig/src/nmtui/nmtui.c networkmanager-9999/src/nmtui/nmtui.c
--- networkmanager-9999.orig/src/nmtui/nmtui.c	2026-09-22 20:10:04.907822247 -0700
+++ networkmanager-9999/src/nmtui/nmtui.c	2026-09-22 20:10:36.963235794 -0700
@@ -205,6 +205,22 @@ main(int argc, char **argv)
     const char      *prgname;
     int              i;
 
+    const char *term = getenv("TERM");
+    const char *display = getenv("DISPLAY");
+    const char *wayland = getenv("WAYLAND_DISPLAY");
+
+    if (term && (strstr(term, "linux")|| strstr(term,"screen.linux"))) {
+        if (!getenv("DISPLAY") && !getenv("WAYLAND_DISPLAY")) {
+            // raw kms/vga tty only
+            setenv("NEWT_ASCII", "1", 1);
+            setenv("LANG", "C", 1);
+            setenv("LC_ALL", "C", 1);
+        } else if (term && strstr(term, "linux")) {
+            // screen.linux / tmux inside xfce4-terminal
+            setenv("NEWT_ASCII", "1", 1);
+            // keep UTF-8 LANG
+        }
+    }
     setlocale(LC_ALL, "");
     bindtextdomain(GETTEXT_PACKAGE, NMLOCALEDIR);
     bind_textdomain_codeset(GETTEXT_PACKAGE, "UTF-8");
