diff '--color=auto' -urp networkmanager-9999.orig/src/libnmt-newt/nmt-newt-utils.c networkmanager-9999/src/libnmt-newt/nmt-newt-utils.c
--- networkmanager-9999.orig/src/libnmt-newt/nmt-newt-utils.c	2026-09-22 20:10:04.803825702 -0700
+++ networkmanager-9999/src/libnmt-newt/nmt-newt-utils.c	2026-09-22 20:11:17.577232799 -0700
@@ -15,6 +15,7 @@
 #include <stdarg.h>
 #include <unistd.h>
 #include <sys/wait.h>
+#include <slang.h>
 
 #include "libnm-glib-aux/nm-io-utils.h"
 #include "libnm-glib-aux/nm-str-buf.h"
@@ -214,6 +215,11 @@ libnm-client-aux-extern * nmt_newt_init:
 void
 nmt_newt_init(void)
 {
+    const char *t=getenv("TERM");
+    if(t && strstr(t,"linux")){
+        setenv("NEWT_ASCII","1",1);
+        SLtt_Has_Alt_Charset = 0;
+    }
     newtInit();
