KUBERNETES_TARGETS=(
	kubernetes_target_1_35
	kubernetes_target_1_36
)

# Cargo must go after distutils-r1
inherit abseil-cpp distutils-r1 cargo grpc pypi re2

KEYWORDS="~amd64"
S="${WORKDIR}/${MY_PN}-${PV}"
SRC_URI="
$(cargo_crate_uris ${CRATES})
https://github.com/chroma-core/chroma/archive/refs/tags/${PV}.tar.gz
	-> ${P}.tar.gz
https://github.com/yoshidan/google-cloud-rust/archive/${GOOGLE_CLOUD_RUST_COMMIT}.tar.gz
	-> google-cloud-rust-${GOOGLE_CLOUD_RUST_COMMIT:0:7}.tar.gz

"
#https://github.com/chroma-core/hnswlib/archive/refs/tags/${CHROMA_CORE_HNSWLIB_PV}.tar.gz
#	-> chroma-core-hnswlib-${CHROMA_CORE_HNSWLIB_PV}.tar.gz

DESCRIPTION="the AI-native open-source embedding database"
HOMEPAGE="
	https://github.com/chroma-core/chroma
	https://pypi.org/project/chromadb
"
LICENSE="
	Apache-2.0
"
RESTRICT="mirror"
SLOT="0"
IUSE+="
${CPU_FLAGS_X86[@]}
${KUBERNETES_TARGETS[@]}
${PROTOBUF_PYTHON[@]/+}
dev helm kubectl kubernetes
ebuild_revision_16
"
REQUIRED_USE+="
	^^ (
		protobuf_python_4
		protobuf_python_5
	)
	kubernetes? (
		^^ (
			${KUBERNETES_TARGETS[@]}
		)
		|| (
			helm
			kubectl
		)
	)
"

# grpcio:>=4 protobuf-python:>=4
gen_grpcio_rdepend_dev() {
	local impl
	for impl in "${PYTHON_COMPAT[@]}" ; do
		echo "
			python_single_target_${impl}? (
				dev-python/grpcio:${PROTOBUF_CPP_SLOT}[python_targets_${impl}(-)]
			)
		"
	done
}

gen_grpcio_bdepend_dev() {
	local impl
	for impl in "${PYTHON_COMPAT[@]}" ; do
		echo "
			(
				python_single_target_${impl}? (
					dev-python/grpcio-tools:${PROTOBUF_CPP_SLOT}[python_targets_${impl}(-)]
					dev-python/protobuf:${PROTOBUF_PYTHON_SLOT}[python_targets_${impl}(-)]
				)
			)
		"
	done
}

gen_grpcio_rdepend_rel() {
	local impl
	for impl in "${PYTHON_COMPAT[@]}" ; do
		echo "
			(
				python_single_target_${impl}? (
					dev-python/grpcio:${PROTOBUF_CPP_SLOT}[python_targets_${impl}(-)]
					dev-python/protobuf:${PROTOBUF_PYTHON_SLOT}[python_targets_${impl}(-)]
				)
			)
		"
	done
}

