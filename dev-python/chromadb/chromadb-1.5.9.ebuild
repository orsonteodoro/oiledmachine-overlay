src_prepare() {
	distutils-r1_src_prepare
	if use kubernetes_target_1_35 ; then
		sed -i -e "s|v1_36|v1_35|g" "${S}/rust/memberlist/Cargo.toml" || die
	fi
	if use kubernetes_target_1_36 ; then
		sed -i -e "s|v1_36|v1_36|g" "${S}/rust/memberlist/Cargo.toml" || die
	fi
}

python_configure() {
	if use protobuf_python_5 ; then
		PROTOBUF_GRPC="5"
		PROTOBUF_CPP_SLOT="5"
		PROTOBUF_PYTHON_SLOT="${PROTOBUF_PYTHON_SLOT_5[@]}"
	elif use protobuf_python_4 ; then
		PROTOBUF_GRPC="4"
		PROTOBUF_CPP_SLOT="4"
		PROTOBUF_PYTHON_SLOT="${PROTOBUF_PYTHON_SLOT_4[@]}"
	fi
	export PROTOC="/usr/lib/protobuf/${PROTOBUF_CPP_SLOT}/bin/protoc"
	abseil-cpp_python_configure
	protobuf_python_configure
	re2_python_configure
	grpc_python_configure
	cargo_src_configure
}

src_configure() {
	if \
		   use cpu_flags_x86_avx \
		|| use cpu_flags_x86_avx512f \
		|| use cpu_flags_x86_sse \
	; then
		:
	else
		export HNSWLIB_NO_NATIVE=1
	fi
	distutils-r1_src_configure
}

