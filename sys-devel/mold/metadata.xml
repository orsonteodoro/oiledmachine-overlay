<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
  <maintainer type="person">
    <!-- Ebuild originators -->
    <email>sam@gentoo.org</email>
    <name>Sam James</name>
  </maintainer>
  <maintainer type="person">
    <!-- Ebuild originators -->
    <email>matthew@gentoo.org</email>
    <name>Matthew Smith</name>
  </maintainer>
  <upstream>
    <remote-id type="github">rui314/mold</remote-id>
  </upstream>
  <use>
    <flag name="balanced">
      - ASLR
      - Guard pages for metadata only
      - UAF mitigation
      - Heap corruption mitigation
    </flag>
    <flag name="mimalloc">
      Optimize memory allocation for memory use efficiency caused by fragmentation
    </flag>
    <flag name="performance-critical">
      - ASLR
      - No guard page mitigation
    </flag>
    <flag name="security-critical">
      - ASLR
      - Every page guarded
      - Guard pages for metadata also
      - UAF mitigation
      - Heap corruption mitigation
    </flag>
    <flag name="system-mimalloc">
      Use mimalloc provided by the system.
    </flag>
    <flag name="system-tbb">
      Use the TBB provided by the system.
    </flag>
  </use>
</pkgmetadata>
