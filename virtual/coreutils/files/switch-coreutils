#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="/"
PROVIDER=""

usage() {
    echo "Usage: $0 [--root /mnt/gentoo] <gnu|uutils|uutils-bin>"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --root)
            ROOT_DIR="${2%/}"
            [[ -z "$ROOT_DIR" ]] && ROOT_DIR="/"
            shift 2
            ;;
        gnu|uutils|uutils-bin)
            PROVIDER="$1"
            shift
            ;;
        *)
            usage
            ;;
    esac
done

[[ -z "$PROVIDER" ]] && usage

case "$PROVIDER" in
    gnu)        SRC_BASE="/usr/lib/gnu-coreutils" ;;
    uutils)     SRC_BASE="/usr/lib/uucore-utils" ;;
    uutils-bin) SRC_BASE="/usr/lib/uutils-coreutils-bin" ;;
esac

TARGET_SRC="${ROOT_DIR}${SRC_BASE}"

if [[ ! -d "${TARGET_SRC}/bin" ]]; then
    echo "Error: ${TARGET_SRC}/bin does not exist." >&2
    exit 1
fi

# Detect merged-usr on target root
IS_MERGED=0
if [[ -L "${ROOT_DIR}/bin" ]]; then
    IS_MERGED=1
    echo "Detected merged-usr layout at ${ROOT_DIR}"
else
    echo "Detected split-usr layout at ${ROOT_DIR}"
fi

# Core utilities typically expected in /bin on split-usr Gentoo systems
ROOT_BIN_UTILS=(
    basename cat chgrp chmod chown cp date dd df echo false ln ls mkdir
    mknod mv pwd rm rmdir sleep stty sync true uname
)

is_root_bin() {
    local item="$1"
    for b in "${ROOT_BIN_UTILS[@]}"; do
        [[ "$b" == "$item" ]] && return 0
    done
    return 1
}

link_dir() {
    local sub="$1" # bin or sbin
    local src_dir="${TARGET_SRC}/${sub}"
    [[ ! -d "$src_dir" ]] && return 0

    for bin_path in "${src_dir}"/*; do
        [[ ! -e "$bin_path" ]] && continue
        local bin_name
        bin_name=$(basename "$bin_path")

        if [[ $IS_MERGED -eq 1 ]]; then
            # Merged-usr: everything links from /usr/{bin,sbin}
            ln -sfn "../lib/${SRC_BASE#/usr/lib/}/${sub}/${bin_name}" \
                "${ROOT_DIR}/usr/${sub}/${bin_name}"
        else
            # Split-usr: essential utils go to /{bin,sbin}, others to /usr/{bin,sbin}
            if [[ "$sub" == "bin" ]] && is_root_bin "$bin_name"; then
                ln -sfn "..${SRC_BASE}/${sub}/${bin_name}" \
                    "${ROOT_DIR}/${sub}/${bin_name}"
                # Optional: remove /usr/bin duplicate if present, or link it too
                ln -sfn "../lib/${SRC_BASE#/usr/lib/}/${sub}/${bin_name}" \
                    "${ROOT_DIR}/usr/${sub}/${bin_name}"
            else
                ln -sfn "../lib/${SRC_BASE#/usr/lib/}/${sub}/${bin_name}" \
                    "${ROOT_DIR}/usr/${sub}/${bin_name}"
            fi
        fi
    done
}

echo "Switching coreutils at ${ROOT_DIR} to ${PROVIDER}..."
link_dir "bin"
link_dir "sbin"
echo "Done."

