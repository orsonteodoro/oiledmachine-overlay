#!/bin/sh
set -e

# This file is mostly AI generated.

# It is assumed that the system is booted with Gentoo LiveUSB, SystemRescue, or
# rescue partition with unpacked Gentoo state3 tarball or SystemRescue.

echo "WARNING:  DRAFT.  This script is not tested yet."

TARGET="${1}"
ROOT_DIR="${2:-/}" # Defaults to / if not provided (e.g., /mnt/gentoo)

# Normalize ROOT_DIR (strip trailing slash unless it's just /)
ROOT_DIR="${ROOT_DIR%/}"

case "${TARGET}" in
    gnu)
        SRC_DIR="lib/gnu-coreutils"
        ;;
    uutils-src)
        SRC_DIR="lib/uutils-coreutils"
        ;;
    uutils-bin)
        SRC_DIR="lib/uutils-coreutils-bin"
        ;;
    *)
        echo "Usage: $0 <gnu|uutils-src|uutils-bin> [target_root]"
        echo "Example (RescueCD): $0 gnu /mnt/gentoo"
        exit 1
        ;;
esac

if [ ! -d "${ROOT_DIR}/${SRC_DIR}/bin" ]; then
    echo "Error: Implementation directory ${ROOT_DIR}/${SRC_DIR}/bin does not exist."
    exit 1
fi

echo "Switching coreutils in '${ROOT_DIR:-/}' to '${TARGET}'..."

# Map /bin utilities (Critical for split-usr early boot)
for bin_path in "${ROOT_DIR}/${SRC_DIR}/bin/"*; do
    [ -e "${bin_path}" ] || continue
    tool="$(basename "${bin_path}")"
    
    # Create relative symlink: /bin/ls -> ../lib/gnu-coreutils/bin/ls
    ln -sfn "../${SRC_DIR}/bin/${tool}" "${ROOT_DIR}/bin/${tool}"
    
    # Optional: Maintain /usr/bin compatibility symlinks if legacy scripts hardcode /usr/bin
    if [ -L "${ROOT_DIR}/usr/bin/${tool}" ] || [ ! -e "${ROOT_DIR}/usr/bin/${tool}" ]; then
        ln -sfn "../../bin/${tool}" "${ROOT_DIR}/usr/bin/${tool}"
    fi
done

# Map /sbin utilities (e.g., chroot, if applicable)
if [ -d "${ROOT_DIR}/${SRC_DIR}/sbin" ]; then
    for sbin_path in "${ROOT_DIR}/${SRC_DIR}/sbin/"*; do
        [ -e "${sbin_path}" ] || continue
        tool="$(basename "${sbin_path}")"
        ln -sfn "../${SRC_DIR}/sbin/${tool}" "${ROOT_DIR}/sbin/${tool}"
    done
fi

echo "Done. Active implementation: ${TARGET}"

