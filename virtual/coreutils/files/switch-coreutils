set -e

# 1. Bootstrap PATH immediately using gnu-coreutils-alt as fallback 
# so 'ln', 'rm', and 'basename' work even if /bin symlinks are broken.
ROOT_PREFIX=""
if [ -d "/mnt/gentoo/lib" ] && [ ! -f "/etc/gentoo-release" ]; then
    ROOT_PREFIX="/mnt/gentoo"
fi

export PATH="${ROOT_PREFIX}/lib/gnu-coreutils/bin:${ROOT_PREFIX}/lib/uutils-coreutils/bin:${ROOT_PREFIX}/lib/uutils-coreutils-bin/bin:/bin:/usr/bin:/sbin:/usr/sbin"

TARGET="$1"
PROVIDER_DIR="${ROOT_PREFIX}/lib/${TARGET}"

if [ -z "$TARGET" ] || [ ! -d "$PROVIDER_DIR/bin" ]; then
    echo "Usage: $0 <gnu-coreutils|uutils-coreutils|uutils-coreutils-bin>"
    echo "Detected root: ${ROOT_PREFIX:-/}"
    exit 1
fi

# 2. Standard split-usr root /bin binaries required for early boot
ROOT_BINS="arch base64 basename cat chgrp chmod chown cp date dd df dir echo false ln ls mkdir mknod mktemp mv pwd readlink rm rmdir sleep stty sync touch true uname vdir"

echo "Switching coreutils on '${ROOT_PREFIX:-/}' to '$TARGET'..."

for bin_path in "$PROVIDER_DIR/bin/"*; do
    [ -e "$bin_path" ] || continue
    bin_name=$(basename "$bin_path")
    
    # Target relative path inside the chroot/system
    rel_target="/lib/${TARGET}/bin/${bin_name}"
    
    # Check if binary belongs in /bin (split-usr) or /usr/bin
    is_root_bin=0
    for rb in $ROOT_BINS; do
        if [ "$bin_name" = "$rb" ]; then
            is_root_bin=1
            break
        fi
    done

    if [ "$is_root_bin" -eq 1 ]; then
        # Place in /bin, and provide compatibility symlink in /usr/bin if needed
        ln -sfn "$rel_target" "${ROOT_PREFIX}/bin/${bin_name}"
        rm -f "${ROOT_PREFIX}/usr/bin/${bin_name}"
    else
        # Place in /usr/bin
        ln -sfn "$rel_target" "${ROOT_PREFIX}/usr/bin/${bin_name}"
        rm -f "${ROOT_PREFIX}/bin/${bin_name}"
    fi
done

# Handle sbin if present (e.g., chroot)
if [ -d "$PROVIDER_DIR/sbin" ]; then
    for sbin_path in "$PROVIDER_DIR/sbin/"*; do
        [ -e "$sbin_path" ] || continue
        sbin_name=$(basename "$sbin_path")
        ln -sfn "/lib/${TARGET}/sbin/${sbin_name}" "${ROOT_PREFIX}/usr/sbin/${sbin_name}"
    done
fi

echo "Done. Active coreutils provider: $TARGET"
