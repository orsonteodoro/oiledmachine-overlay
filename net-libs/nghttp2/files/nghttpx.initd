# This file is AI generated.

extra_started_commands="reload"
description="nghttpx - HTTP/2 and HTTP/3 reverse proxy"
description_reload="Reload configuration file via SIGHUP"

command="/usr/bin/nghttpx"
# Note: DO NOT specify a "user" variable here. We must start as root.
# Let nghttpx drop privileges via --user after setting up neverbleed.
command_args="--conf=${NGHTTPX_CONF:-/etc/nghttpx/nghttpx.conf} \
             --user=nghttpx \
             --pid-file=/run/nghttpx.pid \
             --daemon"

pidfile="/run/nghttpx.pid"

depend() {
    need net
    after firewall
}

reload() {
    ebegin "Reloading ${RC_SVCNAME} configuration"
    start-stop-daemon --signal SIGHUP --pidfile "${pidfile}"
    eend $?
}
