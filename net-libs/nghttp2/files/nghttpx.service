# This file is AI generated.
[Unit]
Description=nghttpx - HTTP/2 and HTTP/3 reverse proxy
After=network.target

[Service]
Type=forking
PIDFile=/run/nghttpx.pid

# Executed as root so neverbleed can isolate private keys before dropping privileges
ExecStart=/usr/bin/nghttpx --conf=/etc/nghttpx/nghttpx.conf --user=nghttpx --pid-file=/run/nghttpx.pid --daemon

# SIGHUP reloads config, spawns new unprivileged workers, and leaves neverbleed intact
ExecReload=/bin/kill -HUP $MAINPID

# Hardening constraints
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
