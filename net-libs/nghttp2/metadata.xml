<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
  <maintainer type="person">
    <!-- Ebuild on the oiledmachine-overlay -->
    <email>orsonteodoro@hotmail.com</email>
    <name>Orson Teodoro</name>
  </maintainer>
  <maintainer type="person">
    <!-- Ebuild originator -->
    <email>voyageur@gentoo.org</email>
    <name>Bernard Cafarelli</name>
  </maintainer>
  <upstream>
    <remote-id type="cpe">cpe:/a:nghttp2:nghttp2</remote-id>
    <remote-id type="github">nghttp2/nghttp2</remote-id>
  </upstream>
  <use>
    <flag name="apparmor">
      Install the nghttpx AppArmor profile.
    </flag>
    <flag name="hpack-tools">
      Install HPACK (header compression) helper tools
    </flag>
    <flag name="mruby">
      Enable mruby support for nghttpx reverse proxy
    </flag>
    <flag name="neverbleed">
      Increase protection against private key leaking when using the nghttpx
      reverse proxy.  Enabling this USE flag protects using multiprocess
      and separation with limited uid/gid.
    </flag>
    <flag name="openrc">
      Install the nghttpx daemon init script for OpenRC.
    </flag>
    <flag name="systemd">
      Install the nghttpx daemon init script for systemd.
    </flag>
    <flag name="utils">
      Adds the following tools:

      nghttp - a HTTP/2 client
      nghttpd - a HTTP/2 server
      nghttpx - a reverse proxy
    </flag>
  </use>
</pkgmetadata>
